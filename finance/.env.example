# ── Database ─────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, RDS, or local). Required.
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance?schema=public"
# Separate database for integration tests (npm test). Never point this at real data.
TEST_DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_test?schema=public"

# ── Auth.js ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Public URL of the app (used in magic links and invoice share links)
AUTH_URL="http://localhost:3000"
# Google sign-in (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Magic-link email: without this the link is printed to the server console.
# Set a webhook that receives POST {to, url} and sends the email (Resend, SES, Postmark…).
EMAIL_WEBHOOK_URL=""
EMAIL_FROM="books@yourdomain.in"
# One-click "Explore the demo company" sign-in. Development and E2E only — never in production.
ALLOW_DEMO_LOGIN="true"

# ── AI (server-side only) ────────────────────────────────
# Without a key the app uses its rule-based drafter and question router.
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5-5
ANTHROPIC_MODEL=""

# ── PDF ─────────────────────────────────────────────────
# Path to a licensed Book Antiqua TTF for PDF headings (falls back to Times-Roman).
PDF_HEADING_FONT=""
