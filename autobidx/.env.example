# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autobidx?schema=public"
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
APP_URL="http://localhost:3000"
# development | demo | production. Demo credentials are only shown when not "production".
APP_MODE="development"

# ── Storage / media ──────────────────────────────────
STORAGE_DIR="./storage"
# Set to a CDN origin (e.g. https://cdn.autobidx.in) to serve /media through a CDN.
MEDIA_BASE_URL=""
MEDIA_CDN_HOST=""

# ── Background jobs ──────────────────────────────────
# Run the job runner (auction closing, notifications) inside the web process.
# In production prefer a dedicated worker: `npm run worker`.
JOBS_IN_PROCESS="true"

# ── Payments ─────────────────────────────────────────
# mock | razorpay | stripe
PAYMENT_GATEWAY="mock"
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Notification providers (optional; console provider used when empty) ──
SMTP_URL=""
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""
PUSH_VAPID_PRIVATE_KEY=""

# ── Field encryption for bank details (32 bytes base64). Falls back to AUTH_SECRET-derived key in dev.
FIELD_ENCRYPTION_KEY=""
